# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify Buy Button (public — used client-side)
# Store domain without https:// (e.g. w5xp4v-ce.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API access token from Shopify Admin → Apps → Develop apps
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (comma-separated emails that can access /admin)
ADMIN_EMAILS=admin@example.com
